#!/usr/bin/env bash
# skill-audit: skills invoked and files edited in Claude Code, Codex and opencode sessions.
#
#   skill-audit status  [session_id]   compact view: counts + recent timeline
#   skill-audit report  [session_id]   full timeline
#   skill-audit watch   [session_id]   live view, redraws every 2s (q to quit)
#   skill-audit list                   recent sessions
#
# Data source: NDJSON logs written by logger.sh (Claude Code and Codex hooks)
# and by the opencode plugin. Default session: most recently modified log.
set -euo pipefail

LOG_DIR="${SKILL_AUDIT_DIR:-$HOME/.claude/skill-audit}"
# Seconds a skill run may sit idle before it stops claiming later edits.
IDLE_GAP=$(( ${SKILL_AUDIT_IDLE_MINUTES:-30} * 60 ))

if [ -t 1 ]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; CYAN=$'\033[36m'; YEL=$'\033[33m'; GRN=$'\033[32m'; RST=$'\033[0m'
else
  BOLD=""; DIM=""; CYAN=""; YEL=""; GRN=""; RST=""
fi

resolve_sid() {
  if [ -n "${1:-}" ]; then printf '%s\n' "$1"; return; fi
  local latest
  latest="$(ls -t "$LOG_DIR"/*.ndjson 2>/dev/null | head -1 || true)"
  [ -n "$latest" ] && basename "$latest" .ndjson
}

local_hhmm() { # $1: ISO-8601 UTC timestamp -> local HH:MM
  jq -rn --arg ts "$1" '$ts | try (fromdateiso8601 | strflocaltime("%H:%M")) catch ""'
}

# Group events into skill runs. A run stops claiming files once IDLE_GAP passes
# with no activity, so one morning skill cannot swallow a whole day of edits.
# Mirrors group() in src/log.ts; the two must agree.
group_runs() { # stdin: NDJSON; emits the run array as JSON
  jq -s --argjson gap "$IDLE_GAP" '
    def epoch: (try (. | fromdateiso8601) catch null);
    reduce .[] as $e ({runs: [], last: null};
      if $e.kind == "skill" then
        {runs: (.runs + [{skill: $e.name, ts: $e.ts, files: []}]), last: ($e.ts | epoch)}
      elif $e.kind == "file" then
        ($e.ts | epoch) as $now
        | (.runs | length == 0) as $empty
        | (($empty | not) and (.runs[-1].skill != "(no skill active)")
           and ($now != null) and (.last != null) and (($now - .last) > $gap)) as $stale
        | (if $empty or $stale
           then .runs + [{skill: "(no skill active)", ts: $e.ts, files: []}]
           else .runs end) as $runs
        | {runs: ($runs[:-1] + [($runs[-1] | .files += [{ts: $e.ts, tool: $e.tool, path: $e.path}])]),
           last: $now}
      else . end)
    | .runs
  ' "$1"
}

# Emit timeline as TSV, one node per line, in the order they are rendered:
#   S<TAB>skill            a skill run
#   H<TAB>hh:mm<TAB>count  an hour bucket inside the run above
#   F<TAB>hh:mm<TAB>tool<TAB>path
# Times are the local clock, converted from the UTC the log stores.
timeline_tsv() {
  group_runs "$1" | jq -r '
    def hhmm: (try (fromdateiso8601 | strflocaltime("%H:%M")) catch "");
    def hourkey: (try (fromdateiso8601 | strflocaltime("%Y-%m-%d %H:00")) catch "");
    .[]
    | [["S", .skill]]
      + ([.files[] | . + {bucket: (.ts | hourkey)}]
         | group_by(.bucket)
         | sort_by(.[0].bucket)
         | map([["H", (.[0].ts | hhmm | .[0:2] + ":00"), (length | tostring)]]
               + map(["F", (.ts | hhmm), .tool, .path]))
         | add // [])
    | .[] | @tsv
  '
}

render_timeline() { # stdin: TSV lines; $1: cwd prefix to strip
  local cwd="${1:-}"
  while IFS=$'\t' read -r type a b c; do
    case "$type" in
      S)
        if [ "$a" = "(no skill active)" ]; then
          printf '  %s⚠ %s%s\n' "$YEL" "$a" "$RST"
        else
          printf '  %s⚡ %s%s\n' "$CYAN" "$a" "$RST"
        fi ;;
      H)
        printf '     %s%s%s  %s(%s)%s\n' "$BOLD" "$a" "$RST" "$DIM" "$b" "$RST" ;;
      F)
        local rel="$c"
        [ -n "$cwd" ] && rel="${c#"$cwd"/}"
        printf '       %s %s✎%s %s  %s%s%s\n' "$a" "$DIM" "$RST" "$rel" "$DIM" "$b" "$RST" ;;
    esac
  done
}

# Keep the last $1 rows, re-emitting the skill and hour headers that were in
# effect at the cut so the tail is not a list of files with no owner.
tail_with_context() {
  awk -F'\t' -v max="$1" '
    { rows[NR] = $0; type[NR] = $1 }
    END {
      if (NR <= max) { for (i = 1; i <= NR; i++) print rows[i]; exit }
      start = NR - max + 1
      s = 0; h = 0
      for (i = 1; i < start; i++) {
        if (type[i] == "S") { s = i; h = 0 }
        else if (type[i] == "H") { h = i }
      }
      if (s) print rows[s]
      if (h) print rows[h]
      for (i = start; i <= NR; i++) print rows[i]
    }
  '
}

session_header_and_body() { # $1: sid, $2: max timeline lines (0 = all)
  local sid="$1" max="$2"
  local log="$LOG_DIR/$sid.ndjson"
  if [ ! -f "$log" ]; then
    printf 'skill-audit: no log for session %s in %s\n' "$sid" "$LOG_DIR"
    return 0
  fi

  local cwd n_runs n_distinct n_files n_orphan t_first t_last
  cwd="$(jq -r 'select(.cwd != null and .cwd != "") | .cwd' "$log" | head -1 || true)"
  n_runs="$(jq -r 'select(.kind=="skill") | .name' "$log" | grep -c . || true)"
  n_distinct="$(jq -r 'select(.kind=="skill") | .name' "$log" | sort -u | grep -c . || true)"
  n_files="$(jq -r 'select(.kind=="file") | .path' "$log" | sort -u | grep -c . || true)"
  t_first="$(jq -r '.ts' "$log" | head -1 || true)"
  t_last="$(jq -r '.ts' "$log" | tail -1 || true)"
  n_orphan="$(group_runs "$log" | jq -r '
    map(select(.skill == "(no skill active)") | .files | length) | add // 0
  ')"

  local c_first c_last
  c_first="$(local_hhmm "$t_first")"
  c_last="$(local_hhmm "$t_last")"

  printf '%s● Skill audit%s — %s %s·%s %s %s·%s %s→%s\n\n' \
    "$BOLD" "$RST" "${sid:0:8}" "$DIM" "$RST" "${cwd/#$HOME/~}" \
    "$DIM" "$RST" "$c_first" "$c_last"

  local tl
  tl="$(timeline_tsv "$log")"
  if [ -z "$tl" ]; then
    printf '  %sno skill or file events recorded yet%s\n' "$DIM" "$RST"
  elif [ "$max" -gt 0 ] && [ "$(printf '%s\n' "$tl" | wc -l)" -gt "$max" ]; then
    printf '  %s… earlier events truncated — `skill-audit report` for all%s\n' "$DIM" "$RST"
    printf '%s\n' "$tl" | tail_with_context "$max" | render_timeline "$cwd"
  else
    printf '%s\n' "$tl" | render_timeline "$cwd"
  fi

  printf '\n%s●%s %s skill runs (%s distinct) · %s files touched' \
    "$GRN" "$RST" "$n_runs" "$n_distinct" "$n_files"
  if [ "$n_orphan" -gt 0 ]; then
    printf ' · %s⚠ %s edits outside skill context%s' "$YEL" "$n_orphan" "$RST"
  fi
  printf '\n'
}

cmd_status() {
  local sid; sid="$(resolve_sid "${1:-}")"
  [ -z "$sid" ] && { printf 'skill-audit: no session logs in %s\n' "$LOG_DIR"; return 0; }
  session_header_and_body "$sid" 14
}

cmd_report() {
  local sid; sid="$(resolve_sid "${1:-}")"
  [ -z "$sid" ] && { printf 'skill-audit: no session logs in %s\n' "$LOG_DIR"; return 0; }
  session_header_and_body "$sid" 0
}

cmd_watch() {
  local sid="${1:-}"
  trap 'tput cnorm 2>/dev/null || true; printf "\n"; exit 0' INT TERM
  tput civis 2>/dev/null || true
  while true; do
    local out
    out="$(cmd_status "$sid" 2>&1 || true)"
    clear
    printf '%s\n\n%slive · refreshed %s · q to quit%s\n' "$out" "$DIM" "$(date +%H:%M:%S)" "$RST"
    local key=""
    read -r -t 2 -n 1 key 2>/dev/null || true
    if [ "$key" = "q" ]; then break; fi
  done
  tput cnorm 2>/dev/null || true
}

cmd_list() {
  local found=0
  for f in $(ls -t "$LOG_DIR"/*.ndjson 2>/dev/null || true); do
    found=1
    local sid cwd ns nf mt
    sid="$(basename "$f" .ndjson)"
    cwd="$(jq -r 'select(.cwd != null and .cwd != "") | .cwd' "$f" | head -1 || true)"
    ns="$(jq -r 'select(.kind=="skill") | .name' "$f" | grep -c . || true)"
    nf="$(jq -r 'select(.kind=="file") | .path' "$f" | sort -u | grep -c . || true)"
    mt="$(date -r "$f" +'%Y-%m-%d %H:%M')"
    printf '%s  %s%-10s%s ⚡%-3s ✎%-3s %s%s%s\n' \
      "$mt" "$BOLD" "${sid:0:8}" "$RST" "$ns" "$nf" "$DIM" "${cwd/#$HOME/~}" "$RST"
  done
  [ "$found" -eq 0 ] && printf 'skill-audit: no session logs in %s\n' "$LOG_DIR"
  return 0
}

case "${1:-status}" in
  status) cmd_status "${2:-}" ;;
  report) cmd_report "${2:-}" ;;
  watch)  cmd_watch  "${2:-}" ;;
  list)   cmd_list ;;
  -h|--help|help)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)
    printf 'skill-audit: unknown command "%s" (status|report|watch|list)\n' "$1" >&2
    exit 1 ;;
esac
